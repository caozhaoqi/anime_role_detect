# ==============================================
# 环境变量配置示例 - Environment Variables Example
# 复制此文件为 .env 并根据实际环境修改
# ==============================================

# ------------------------------
# 应用配置
# ------------------------------
APP_NAME=anime-role-detect
APP_ENV=development  # development, staging, production
APP_DEBUG=true
APP_VERSION=2.0.0

# ------------------------------
# 服务器配置
# ------------------------------
HOST=0.0.0.0
PORT=8000

# ------------------------------
# 数据库配置
# ------------------------------
DATABASE_URL=sqlite:///./test.db
# DATABASE_URL=postgresql://user:password@localhost:5432/ard_db
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/ard_db

# 连接池配置
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_TIMEOUT=30

# ------------------------------
# Redis 配置
# ------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DB=0

# ------------------------------
# JWT 配置
# ------------------------------
JWT_SECRET_KEY=your-secret-key-here-must-be-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------
# 安全配置
# ------------------------------
# 速率限制配置（每小时最大请求数）
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=3600

# ------------------------------
# 文件上传配置
# ------------------------------
# 最大文件大小（字节），默认 50MB
MAX_FILE_SIZE=52428800

# ------------------------------
# CORS 配置
# ------------------------------
CORS_ALLOWED_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# ------------------------------
# 日志配置
# ------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# ------------------------------
# 模型配置
# ------------------------------
MODEL_DIR=models/
DEFAULT_MODEL=efficientnet_b3_loli_optimized_v2
MODEL_DEVICE=cpu  # cpu, cuda, mps

# ------------------------------
# 安全配置
# ------------------------------
PASSWORD_HASH_ALGORITHM=sha256_crypt
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_WINDOW_SECONDS=3600

# ------------------------------
# 监控配置
# ------------------------------
PROMETHEUS_ENABLED=true
METRICS_PORT=9090

# ------------------------------
# 文件上传配置
# ------------------------------
MAX_FILE_SIZE=52428800  # 50MB
ALLOWED_FILE_EXTENSIONS=[".jpg", ".jpeg", ".png", ".gif", ".webp"]
