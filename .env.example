# ==============================================
# 环境变量配置示例 - Environment Variables Example
# 复制此文件为 .env 并根据实际环境修改
# ==============================================

# ------------------------------
# 应用配置
# ------------------------------
APP_NAME=anime-role-detect
APP_ENV=development  # development, staging, production
APP_DEBUG=true
APP_VERSION=2.2.0

# ------------------------------
# 服务器配置
# ------------------------------
HOST=0.0.0.0
PORT=8000
WORKERS=4
THREADS=4

# ------------------------------
# 数据库配置
# ------------------------------
DATABASE_URL=sqlite:///./test.db
# DATABASE_URL=postgresql://user:password@localhost:5432/ard_db
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/ard_db

# 连接池配置
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=50
DB_TIMEOUT=30
DB_ECHO=false

# ------------------------------
# Redis 配置
# ------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DB=0

# Redis 连接池配置
REDIS_MAX_CONNECTIONS=100
REDIS_MIN_CONNECTIONS=10
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_RETRY_ON_TIMEOUT=true

# ------------------------------
# JWT 配置
# ------------------------------
JWT_SECRET_KEY=your-64-character-secret-key-here-must-be-at-least-64-characters-for-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_COOKIE_SECURE=false
JWT_COOKIE_HTTPONLY=true

# ------------------------------
# 安全配置
# ------------------------------
# 速率限制配置
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_WINDOW_SECONDS=3600
RATE_LIMIT_CLEANUP_INTERVAL=300

# 密码哈希算法
PASSWORD_HASH_ALGORITHM=bcrypt
BCRYPT_ROUNDS=12

# CORS 配置
CORS_ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS"]
CORS_ALLOW_HEADERS=["*"]

# ------------------------------
# 文件上传配置
# ------------------------------
MAX_FILE_SIZE=52428800  # 50MB
ALLOWED_FILE_EXTENSIONS=[".jpg", ".jpeg", ".png", ".gif", ".webp", ".mp4", ".avi", ".mov"]
UPLOAD_DIR=uploads/

# ------------------------------
# 日志配置
# ------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DIR=logs/
LOG_FILE_MAX_BYTES=10485760  # 10MB
LOG_FILE_BACKUPS=50

# ------------------------------
# 模型配置
# ------------------------------
MODEL_DIR=models/
DEFAULT_MODEL=efficientnet_b0
MODEL_DEVICE=auto  # auto, cpu, cuda, mps
MODEL_WARMUP=true
MODEL_CACHE_ENABLED=true
MODEL_BATCH_SIZE=8

# ------------------------------
# 监控配置
# ------------------------------
PROMETHEUS_ENABLED=true
METRICS_PORT=9090
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30

# ------------------------------
# Supervisor 配置（用于进程管理）
# ------------------------------
SUPERVISOR_USERNAME=admin
SUPERVISOR_PASSWORD=your-supervisor-password-here

# ------------------------------
# 消息队列配置
# ------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin
RABBITMQ_VHOST=/

# ------------------------------
# 缓存配置
# ------------------------------
CACHE_ENABLED=true
CACHE_TTL=3600  # 缓存过期时间（秒）
CACHE_PREFIX=ard:

# ------------------------------
# 性能优化配置
# ------------------------------
ENABLE_GZIP_COMPRESSION=true
ENABLE_BROTLI_COMPRESSION=false
MAX_REQUEST_SIZE=50MB
REQUEST_TIMEOUT=60

# ------------------------------
# 分布式追踪配置（可选）
# ------------------------------
JAEGER_ENABLED=false
JAEGER_HOST=localhost
JAEGER_PORT=6831