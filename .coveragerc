[run]
source = src
omit =
    */tests/*
    */test_*
    */migrations/*
    */__pycache__/*
    *.venv/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:

fail_under = 50
precision = 2
show_missing = True
