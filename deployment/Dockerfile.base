# ARD 共享基础镜像 — 包含通用系统依赖和核心 Python 依赖
# 所有非 ML 服务继承此镜像，只需 COPY 代码即可

ARG REGISTRY_MIRROR=docker.io
FROM ${REGISTRY_MIRROR}/library/python:3.9-slim

ARG PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
ENV PIP_INDEX_URL=${PIP_INDEX_URL}

ARG BUILD_DATE
ARG BUILD_TAG

LABEL org.opencontainers.image.created=$BUILD_DATE
LABEL org.opencontainers.image.version=$BUILD_TAG
LABEL org.opencontainers.image.description="ARD shared base image"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_TIMEOUT=120 \
    PIP_DEFAULT_TIMEOUT=120

RUN sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update && apt-get install -y --no-install-recommends \
       libgl1 \
       libglib2.0-0 \
       libsm6 \
       libxext6 \
       libxrender-dev \
       procps \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

COPY requirements-base.txt /tmp/requirements-base.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --timeout=120 --retries=3 -r /tmp/requirements-base.txt \
    && rm /tmp/requirements-base.txt

WORKDIR /app
ENV PYTHONPATH="/app"
ENV LOG_LEVEL="INFO"