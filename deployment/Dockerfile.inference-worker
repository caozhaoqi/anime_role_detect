ARG REGISTRY_MIRROR=docker.io
FROM ${REGISTRY_MIRROR}/library/python:3.9-slim

WORKDIR /app

ARG PIP_INDEX_URL=https://pypi.org/simple/
ENV PIP_INDEX_URL=${PIP_INDEX_URL}

ARG BUILD_DATE
ARG BUILD_TAG

LABEL org.opencontainers.image.created=$BUILD_DATE
LABEL org.opencontainers.image.version=$BUILD_TAG

RUN apt-get update && apt-get install -y \
    build-essential \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

COPY requirements.txt .
COPY requirements-ml.txt .
RUN pip install --no-cache-dir -r requirements.txt -r requirements-ml.txt

COPY .env.example .env
COPY src/ ./src/

RUN mkdir -p logs run

ENV PYTHONPATH="/app"
ENV LOG_LEVEL="INFO"
ENV OMP_NUM_THREADS="1"
ENV MKL_NUM_THREADS="1"
ENV KMP_DUPLICATE_LIB_OK="TRUE"
ENV MKL_THREADING_LAYER="GNU"

CMD ["python", "src/services/inference_worker/worker.py", "--num-workers", "2", "--model", "ViT-B/32"]