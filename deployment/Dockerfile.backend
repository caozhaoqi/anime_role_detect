# Dockerfile for backend API
FROM python:3.9-slim

WORKDIR /app

# 跨平台环境变量配置
# 开启 Python 内置崩溃堆栈打印 (跨平台通用)
ENV PYTHONFAULTHANDLER=1

# 强制实时刷新日志，防止崩溃时缓冲区日志丢失
ENV PYTHONUNBUFFERED=1

# 针对 Mac MPS 的优化：当显存占用达到 80% 时强制回收
ENV PYTORCH_MPS_HIGH_WATERMARK_RATIO=0.8

# 启用内存监控
ENV ENABLE_MEMORY_MONITOR=true

# 启用诊断日志
ENV ENABLE_DIAGNOSTICS=true

# 设置诊断日志文件路径
ENV DIAGNOSTICS_LOG_FILE=logs/diagnostics.log

# 设置崩溃日志文件路径
ENV CRASH_LOG_FILE=logs/crash.log

# 设置性能监控日志文件路径
ENV PERFORMANCE_LOG_FILE=logs/performance.log

# 设置内存警告阈值（百分比）
ENV MEMORY_WARNING_THRESHOLD=85

# 设置内存紧急阈值（百分比）
ENV MEMORY_CRITICAL_THRESHOLD=95

# 设置GPU内存警告阈值（百分比）
ENV GPU_MEMORY_WARNING_THRESHOLD=85

# 设置GPU内存紧急阈值（百分比）
ENV GPU_MEMORY_CRITICAL_THRESHOLD=95

# 设置日志级别
ENV LOG_LEVEL=INFO

# 设置模型缓存大小
ENV CACHE_SIZE=1000

# 设置API超时时间
ENV API_TIMEOUT=30

# 设置最大工作线程数
ENV MAX_WORKERS=4

# 设置批量处理的最大文件数
ENV MAX_BATCH_FILES=10

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 创建必要的目录
RUN mkdir -p logs temp

COPY src/backend/ ./backend/
COPY src/core/ ./core/
COPY src/utils/ ./utils/
COPY coreml_models/ ./coreml_models/

EXPOSE 8000

CMD ["python", "backend/api/run_api.py"]
