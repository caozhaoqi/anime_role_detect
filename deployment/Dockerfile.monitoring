# 统一监控镜像 — 合并 health-check / log-monitor / log-viewer /
# resource-monitor / monitor-dashboard 为单个镜像
# 通过 CMD 参数区分运行模式

ARG REGISTRY_MIRROR=docker.io
FROM ${REGISTRY_MIRROR}/library/python:3.9-slim

# ARG PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# ENV PIP_INDEX_URL=${PIP_INDEX_URL}

ARG BUILD_DATE
ARG BUILD_TAG

LABEL org.opencontainers.image.created=$BUILD_DATE
LABEL org.opencontainers.image.version=$BUILD_TAG
LABEL org.opencontainers.image.description="ARD unified monitoring image"

RUN sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources

RUN apt-get update && apt-get install -y --no-install-recommends \
    procps \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

COPY deployment/requirements-monitoring.txt /tmp/requirements-monitoring.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-cache-dir -r /tmp/requirements-monitoring.txt \
    && rm /tmp/requirements-monitoring.txt

WORKDIR /app

COPY .env.example .env
COPY src/ ./src/
COPY scripts/ ./scripts/
COPY deployment/monitoring-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

RUN mkdir -p logs run

ENV PYTHONPATH="/app"
ENV LOG_LEVEL="INFO"

ENTRYPOINT ["/entrypoint.sh"]
