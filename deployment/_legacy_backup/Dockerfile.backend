# Multi-stage Dockerfile for Backend API Service
ARG REGISTRY_MIRROR=docker.io

# Stage 1: Builder stage
FROM ${REGISTRY_MIRROR}/library/python:3.9-slim AS builder

WORKDIR /app

ARG PIP_INDEX_URL=https://pypi.org/simple/
ENV PIP_INDEX_URL=${PIP_INDEX_URL}

# Install build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    libgl1 \
    libglib2.0-0 \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.txt .

# Install to separate directory
RUN pip install --no-cache-dir --target=/app/deps -r requirements.txt

# Stage 2: Runtime stage
ARG REGISTRY_MIRROR
FROM ${REGISTRY_MIRROR}/library/python:3.9-slim AS runtime

WORKDIR /app

ARG PIP_INDEX_URL=https://pypi.org/simple/
ENV PIP_INDEX_URL=${PIP_INDEX_URL}

# Install runtime dependencies only
RUN apt-get update && apt-get install -y \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Copy dependencies from builder
COPY --from=builder /app/deps /usr/local/lib/python3.9/site-packages

# Environment variables
ENV PYTHONFAULTHANDLER=1
ENV PYTHONUNBUFFERED=1
ENV PYTORCH_MPS_HIGH_WATERMARK_RATIO=0.8
ENV ENABLE_MEMORY_MONITOR=true
ENV ENABLE_DIAGNOSTICS=true
ENV DIAGNOSTICS_LOG_FILE=logs/diagnostics.log
ENV CRASH_LOG_FILE=logs/crash.log
ENV PERFORMANCE_LOG_FILE=logs/performance.log
ENV MEMORY_WARNING_THRESHOLD=85
ENV MEMORY_CRITICAL_THRESHOLD=95
ENV GPU_MEMORY_WARNING_THRESHOLD=85
ENV GPU_MEMORY_CRITICAL_THRESHOLD=95
ENV LOG_LEVEL=INFO
ENV CACHE_SIZE=1000
ENV API_TIMEOUT=30
ENV MAX_WORKERS=4
ENV MAX_BATCH_FILES=10

# Copy source files
COPY src/backend/ ./backend/
COPY src/core/ ./core/
COPY src/utils/ ./utils/
COPY coreml_models/ ./coreml_models/

# Create directories
RUN mkdir -p logs temp

# Expose port
EXPOSE 8000

# Run
CMD ["python", "backend/api/run_api.py"]
