# ARD ML 基础镜像 — 继承 base，额外预装 PyTorch / transformers 等重型 ML 依赖
# model-service 和 inference-worker 继承此镜像

ARG REGISTRY_MIRROR=docker.io
ARG BASE_IMAGE=ardc/base:latest
FROM ${BASE_IMAGE}

ARG PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
ENV PIP_INDEX_URL=${PIP_INDEX_URL}

LABEL org.opencontainers.image.description="ARD ML base image with PyTorch and ML libraries"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_TIMEOUT=300 \
    PIP_DEFAULT_TIMEOUT=300

RUN sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update && apt-get install -y --no-install-recommends \
       build-essential \
       libopenblas-dev \
       git \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

COPY requirements-ml.txt /tmp/requirements-ml.txt

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install torch==2.1.0 torchvision==0.16.0 torchaudio==2.1.0 \
       --index-url https://download.pytorch.org/whl/cpu \
       --timeout=300 --retries=5 \
    && pip install --timeout=120 --retries=3 -r /tmp/requirements-ml.txt \
    && rm /tmp/requirements-ml.txt

ENV OMP_NUM_THREADS="1" \
    MKL_NUM_THREADS="1" \
    KMP_DUPLICATE_LIB_OK="TRUE" \
    MKL_THREADING_LAYER="GNU" \
    PYTORCH_MPS_DISABLE="1"